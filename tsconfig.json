{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@rickrosten/agent-deterministic-tools-core": ["packages/core/src/index.ts"],
      "@rickrosten/agent-deterministic-tools-math": ["packages/math/src/index.ts"],
      "@rickrosten/agent-deterministic-tools-statistics": ["packages/statistics/src/index.ts"],
      "@rickrosten/agent-deterministic-tools-finance": ["packages/finance/src/index.ts"],
      "@rickrosten/agent-deterministic-tools-datetime": ["packages/datetime/src/index.ts"],
      "@rickrosten/agent-deterministic-tools-units": ["packages/units/src/index.ts"],
      "@rickrosten/agent-deterministic-tools-mcp": ["packages/mcp/src/index.ts"],
      "@rickrosten/agent-deterministic-tools-openai": ["packages/openai/src/index.ts"],
      "@rickrosten/agent-deterministic-tools": ["packages/cli/src/index.ts"],
      "@acme/chemistry": ["examples/acme-chemistry/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "apps/*/src",
    "examples/*/src",
    "examples/*/tests",
    "tests",
    "vitest.config.ts"
  ],
  "exclude": ["**/dist", "**/node_modules"]
}
